<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- CCS/1 SEC:WN-135 normal permission for ring-stream mute; no privileged MODIFY_PHONE_STATE. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- WN-50: find my phone vibrates with its ring. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application>
        <!-- WN-46: only so Android lets WindConnect read media sessions (PROTOCOL.md §9.6 rule 6); it reads no notifications.
             Bound only by the system (BIND_NOTIFICATION_LISTENER_SERVICE), after the person grants access in system settings. -->
        <service
            android:name="io.github.prejas3.windconnect.core.MediaListenerService"
            android:label="WindConnect: odtwarzacz na komputerze"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- WN-42: reads notifications for the PC, its own consent (PROTOCOL.md §9.6 rule 6, §9.7): a separate entry in the system's
             notification access, and the in-app setting (off by default); off, it unbinds itself. Bound only by the system. -->
        <service
            android:name="io.github.prejas3.windconnect.core.NotifyListenerService"
            android:label="WindConnect: powiadomienia na komputerze"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- WN-47: the PC media notification's buttons; not exported, reached only through our PendingIntents. -->
        <receiver
            android:name="io.github.prejas3.windconnect.core.PcMediaActionReceiver"
            android:exported="false" />
        <!-- WN-50: the ring notification's "Zatrzymaj"; not exported, reached only through our PendingIntent. -->
        <receiver
            android:name="io.github.prejas3.windconnect.core.FindStopReceiver"
            android:exported="false" />
        <!-- WN-56: MMS PDUs from the PC, read by Android's MMS service through a one-off URI grant. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mmsout"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/mms_out" />
        </provider>
        <!-- WN-36: received clipboard images. Not exported: reachable only through the clip's URI grant. -->
        <provider
            android:name="io.github.prejas3.windconnect.core.ClipImageProvider"
            android:authorities="${applicationId}.clipimage"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
