<?xml version="1.0" encoding="utf-8"?>
<!-- WN-171: the picker's preview and the loading state look like the widget: name with its dot, a state line and the
     two actions of the default size, in the brand's light or dark colours (brand_colors, values-night). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="@drawable/widget_preview_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textColor="@color/brand_on_surface" android:textSize="16sp" android:textStyle="bold"
        android:fontFamily="@font/dm_sans" android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_description" android:textColor="@color/brand_on_surface_variant" android:textSize="13sp"
        android:fontFamily="@font/dm_sans" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_preview_button" android:gravity="center" android:text="@string/widget_short_clipboard"
            android:textColor="@color/brand_on_primary_container" android:textSize="13sp" android:fontFamily="@font/dm_sans" android:maxLines="1" />
        <Space android:layout_width="8dp" android:layout_height="match_parent" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_preview_button" android:gravity="center" android:text="@string/widget_short_app"
            android:textColor="@color/brand_on_primary_container" android:textSize="13sp" android:fontFamily="@font/dm_sans" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
