<?xml version="1.0" encoding="utf-8"?>
<!-- WN-171/WN-175: the picker's preview and the loading state look like the widget: the device row (computer icon, name,
     a state line) and the round actions of the default size, in the brand's light or dark colours (brand_colors, values-night). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_preview_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:importantForAccessibility="no"
            android:background="@drawable/widget_preview_device" android:src="@drawable/ic_widget_pc" android:tint="@color/brand_on_surface" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_name" android:textColor="@color/brand_on_surface" android:textSize="16sp" android:textStyle="bold"
                android:fontFamily="@font/dm_sans" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_description" android:textColor="@color/brand_on_surface_variant" android:textSize="13sp"
                android:fontFamily="@font/dm_sans" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:importantForAccessibility="no"
            android:background="@drawable/widget_preview_round" android:src="@drawable/ic_widget_clipboard" android:tint="@color/brand_on_primary_container" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:importantForAccessibility="no"
            android:background="@drawable/widget_preview_round" android:src="@drawable/ic_widget_file" android:tint="@color/brand_on_primary_container" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:importantForAccessibility="no"
            android:background="@drawable/widget_preview_round" android:src="@drawable/ic_widget_touch" android:tint="@color/brand_on_primary_container" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:importantForAccessibility="no"
            android:background="@drawable/widget_preview_round" android:src="@drawable/ic_widget_app" android:tint="@color/brand_on_primary_container" />
    </LinearLayout>
</LinearLayout>
