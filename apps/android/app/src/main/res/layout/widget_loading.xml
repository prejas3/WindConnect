<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_preview_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textColor="#15282F" android:textSize="16sp" android:fontFamily="@font/dm_sans" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_description" android:textColor="#52686E" android:textSize="12sp" android:fontFamily="@font/dm_sans" />
</LinearLayout>
