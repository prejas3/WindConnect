{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindConnect",
  "version": "0.77.1",
  "identifier": "io.github.prejas3.windconnect",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "windowClassname": "WindConnect.MainWindow",
        "visible": false,
        "title": "WindConnect",
        "width": 920,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "minWidth": 400,
        "minHeight": 300
      },
      {
        "label": "tray-menu",
        "title": "WindConnect — menu",
        "url": "tray-menu.html",
        "visible": false,
        "width": 280,
        "height": 250,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "panel",
        "title": "WindConnect — panel",
        "url": "panel.html",
        "visible": false,
        "width": 380,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "capabilities": [{"identifier":"tray-events","windows":["tray-menu","panel","main","sms"],"permissions":["core:event:allow-listen","core:event:allow-unlisten"]}],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "license": "MIT",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "upgradeCode": "1ea58a16-cb59-4db1-88b4-24e01442f8f3",
        "language": "en-US",
        "fragmentPaths": ["wix/firewall.wxs"],
        "componentRefs": ["WindConnectLanFirewall"]
      }
    }
  }
}
