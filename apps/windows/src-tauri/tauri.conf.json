{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindConnect",
  "version": "0.21.0",
  "identifier": "io.github.prejas3.windconnect",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WindConnect",
        "width": 920,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "license": "MIT",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "upgradeCode": "1ea58a16-cb59-4db1-88b4-24e01442f8f3",
        "language": "en-US",
        "fragmentPaths": ["wix/firewall.wxs"],
        "componentRefs": ["WindConnectLanFirewall"]
      }
    }
  }
}
